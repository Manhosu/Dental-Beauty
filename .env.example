NODE_ENV=development
PORT=3000
REDIS_URL=redis://localhost:6379
CLINICORP_API_BASE=https://api.clinicorp.com/rest/v1
CLINICORP_API_USER=
CLINICORP_API_TOKEN=
CLINICORP_SUBSCRIBER_ID=oralmultiedentalbeauty
CLINICORP_BUSINESS_ID=6247357829611520
# Código de acesso do Agendamento Online (code_link). Dental Beauty = 60903 (ou slug 'dentalbeauty')
CLINICORP_ACCESS_CODE=60903
# Nome do parâmetro do código de acesso (default já é 'code_link')
CLINICORP_ACCESS_CODE_PARAM=code_link
# Chatbotify é opcional no microserviço (Arquitetura C)
CHATBOTIFY_API_BASE=
CHATBOTIFY_API_TOKEN=
# Chave compartilhada com o Flow Builder (header X-Api-Key). Se vazia, não há enforcement (local/dev aberto)
API_KEY_SECRET=
# Réguas (Cron-Engine §3.4). Dormentes por padrão. Ligar com 'true' + a config do fluxo "Gatilho HTTP" do Chatbotify.
# Pegar URL + headers (id/token/flow) no painel "Configurar propriedades" do bloco Gatilho HTTP.
REGUAS_ENABLED=false
CHATBOTIFY_REGUA_WEBHOOK_URL=
CHATBOTIFY_REGUA_ACCOUNT_ID=
CHATBOTIFY_REGUA_TOKEN=
CHATBOTIFY_REGUA_FLOW=
# id do 2º fluxo (no-show/lembrete) — quando existir, liga a régua de no-show automaticamente
CHATBOTIFY_REGUA_FLOW_NOSHOW=
# id do 3º fluxo (pós-procedimento/retorno) — gatilho: agendamento ATENDIDO (StatusId=CHECKOUT) há N meses
CHATBOTIFY_REGUA_FLOW_POSPROC=
# id do fluxo de NPS pós-consulta — gatilho: consulta ATENDIDA (CHECKOUT) no dia anterior; IA trata nota→Maps
CHATBOTIFY_REGUA_FLOW_NPS=
# id do fluxo de REENGAJAMENTO — gatilho: atendido há 6/12 meses e sem nenhum agendamento desde então
CHATBOTIFY_REGUA_FLOW_INATIVIDADE=
# Integração do discador Sonax → API CRM do Chatbotify (dormente até preencher ID + TOKEN).
# Base default já aponta pro webhook público do Chatbotify.
CHATBOTIFY_CRM_API_BASE=https://webhook.chatbotify.com.br/webhook/api_chatbotify
CHATBOTIFY_CRM_ACCOUNT_ID=
CHATBOTIFY_CRM_API_TOKEN=
# Token que vai na URL do webhook configurada no painel Sonax (?token=...). Autentica a chamada do Sonax.
SONAX_WEBHOOK_TOKEN=
